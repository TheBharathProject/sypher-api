# Copy to .env (gitignored) for local dev OR source from ~/.pg-secret on the VM.

# ============================================================================
# Core
# ============================================================================

# Connection string. On the VM, use host.docker.internal in place of 127.0.0.1
# when the container needs to reach Postgres on the host.
DATABASE_URL=postgresql://sypher:CHANGE_ME@127.0.0.1:5432/sypher

# Shared secret for the /waitlist endpoint. Generate with:
#   openssl rand -hex 32
WAITLIST_API_KEY=CHANGE_ME

# Salt for IP hashing — never log raw IPs. Generate with:
#   openssl rand -hex 16
IP_SALT=CHANGE_ME

# Comma-separated allowed CORS origins.
CORS_ORIGINS=https://sypher.in,https://www.sypher.in,http://localhost:3000

# "dev" or "prod" — affects logging verbosity in future, today only validates
ENV=prod

# Listen address. Inside the container we bind 0.0.0.0:8000; the host
# publishes this to 127.0.0.1:8002 so only Caddy can reach it.
HTTP_LISTEN_ADDR=:8000

# ============================================================================
# Auth (Google OAuth + JWT)
# ============================================================================

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client.
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME

# Where Google redirects after consent. Must match an entry in the Cloud
# Console authorised redirect URIs.
GOOGLE_OAUTH_REDIRECT_URL=https://api.sypher.in/auth/google/callback

# HS256 signing secret for issued JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Optional — defaults are fine for the canonical deployment.
JWT_ISSUER=sypher.in
JWT_AUDIENCE=sypher.in
JWT_TTL=168h

# Where the OAuth callback redirects the user with ?token=<jwt>. The frontend
# /auth/callback page reads this and stores the token.
FRONTEND_LOGIN_REDIRECT_URL=https://sypher.in/job-tracker/auth/callback

# ============================================================================
# Storage (Cloudflare R2) — Phase 2
# ============================================================================
# Optional in Phase 1. Required when /resumes/upload-url and friends are hit.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sypher-job-tracker
# Optional public URL prefix if files are served via a custom domain.
R2_PUBLIC_URL=

# ============================================================================
# AI (Deepseek) — Phase 2
# ============================================================================
# Optional in Phase 1. Required when /ai/* endpoints are hit.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Per-user monthly token cap (input + output combined). Returns 429 once hit.
AI_USAGE_MONTHLY_TOKEN_LIMIT=1000000
