# Copy to .env (gitignored) for local dev OR source from ~/.pg-secret on the VM.

# ============================================================================
# Core
# ============================================================================

# Connection string. On the VM, use host.docker.internal in place of 127.0.0.1
# when the container needs to reach Postgres on the host.
DATABASE_URL=postgresql://sypher:CHANGE_ME@127.0.0.1:5432/sypher

# Shared secret for the /waitlist endpoint. Generate with:
#   openssl rand -hex 32
WAITLIST_API_KEY=CHANGE_ME

# Salt for IP hashing — never log raw IPs. Generate with:
#   openssl rand -hex 16
IP_SALT=CHANGE_ME

# Comma-separated allowed CORS origins.
CORS_ORIGINS=https://sypher.in,https://www.sypher.in,http://localhost:3000

# "dev" or "prod" — affects logging verbosity in future, today only validates
ENV=prod

# Listen address. Inside the container we bind 0.0.0.0:8000; the host
# publishes this to 127.0.0.1:8002 so only Caddy can reach it.
HTTP_LISTEN_ADDR=:8000

# ============================================================================
# Auth (Google OAuth + JWT)
# ============================================================================

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client.
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME

# Where Google redirects after consent. Must match an entry in the Cloud
# Console authorised redirect URIs.
GOOGLE_OAUTH_REDIRECT_URL=https://api.sypher.in/auth/google/callback

# HS256 signing secret for issued JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Optional — defaults are fine for the canonical deployment.
JWT_ISSUER=sypher.in
JWT_AUDIENCE=sypher.in
JWT_TTL=168h

# Where the OAuth callback redirects the user with #token=<jwt> (URL
# fragment so the token never hits server logs / Referer headers).
# The /auth/callback page reads the fragment and stores the token.
# NOTE: must include the FE basePath. job-tracker uses basePath "/pegasus"
# (see next.config.mjs), so the route lives under /pegasus/auth/callback.
FRONTEND_LOGIN_REDIRECT_URL=https://sypher.in/pegasus/auth/callback

# ============================================================================
# Storage (Cloudflare R2) — Phase 2
# ============================================================================
# Optional in Phase 1. Required when /resumes/upload-url and friends are hit.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sypher-job-tracker
# Optional public URL prefix if files are served via a custom domain.
R2_PUBLIC_URL=

# ============================================================================
# AI (Deepseek) — Phase 2
# ============================================================================
# Optional in Phase 1. Required when /ai/* endpoints are hit.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Per-user monthly FREE token cap (input + output combined). When this
# is exhausted, AI calls fall back to the paid credits balance (see
# internal/billing/costs.go). Defaults to 25k tokens — roughly enough
# for a handful of resume reports + cover letters per month.
AI_USAGE_MONTHLY_TOKEN_LIMIT=25000

# ============================================================================
# Billing (Razorpay) — Phase 6b
# ============================================================================
# Optional in Phases 1-5. Required when any /billing/* endpoint or the
# /webhooks/razorpay handler is hit. Without these, billing handlers
# respond 503 service_unavailable and the rest of the app keeps working.
#
# Local dev: use test mode keys (rzp_test_*). Test card: 4111 1111 1111 1111
# with any future expiry and CVV. See docs/adr/0006-razorpay-billing.md.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set per-endpoint in the Razorpay dashboard → Settings → Webhooks.
# Used for HMAC-SHA256 signature verification on /webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Plan id of the ₹99/mo standard recurring subscription, created once
# in the dashboard → Subscriptions → Plans. Format: plan_xxx.
RAZORPAY_PLAN_ID=
# Plan id of the ₹299/mo Premium+ tier (premium + 200 credits per
# charge). Optional — when blank, /billing/checkout/subscription-plus
# returns 503 and the Premium+ card on /upgrade is hidden.
RAZORPAY_PLAN_ID_PLUS=

# Slack incoming-webhook URL for feedback delivery. Optional — when
# blank, /feedback only writes to job_tracker.feedback (the prior
# behaviour). When set, a short one-line notification fires per
# submission so we see ideas and bug reports in real time.
SLACK_FEEDBACK_WEBHOOK_URL=

# ============================================================================
# LaTeX compile sidecar — Resume Builder PDF export
# ============================================================================
# Base URL of the LaTeX compile service (yotech/latex-on-http or
# compatible). When blank, /resume-builder/.../render/pdf returns 503
# and the FE falls back to showing raw .tex source.
#
# Local dev (Mac):
#   docker pull yotech/latex-on-http
#   docker run -d --name sypher-tex -p 8090:80 yotech/latex-on-http
#   → set LATEX_SERVICE_URL=http://localhost:8090 here
#
# Production (OCI VM, on sypher-net):
#   docker pull yotech/latex-on-http
#   docker run -d --name sypher-tex --network sypher-net \
#     --restart unless-stopped yotech/latex-on-http
#   → set LATEX_SERVICE_URL=http://sypher-tex
LATEX_SERVICE_URL=
