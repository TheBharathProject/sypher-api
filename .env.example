# Copy to .env (gitignored) for local dev OR source from ~/.pg-secret on the VM.

# Connection string. On the VM, use host.docker.internal in place of 127.0.0.1
# when the container needs to reach Postgres on the host.
DATABASE_URL=postgresql://sypher:CHANGE_ME@127.0.0.1:5432/sypher

# Shared secret for the /waitlist endpoint. Generate with:
#   openssl rand -hex 32
WAITLIST_API_KEY=CHANGE_ME

# Salt for IP hashing — never log raw IPs. Generate with:
#   openssl rand -hex 16
IP_SALT=CHANGE_ME

# Comma-separated allowed CORS origins.
CORS_ORIGINS=https://sypher.in,https://www.sypher.in

# "dev" exposes /docs and /openapi.json; "prod" hides them.
ENV=prod
